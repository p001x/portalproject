{
  "name": "geoportal",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2024-09-23",
  "assets": {
    "directory": "artifacts/geoportal/dist/public",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  "triggers": {
    "crons": [
      "*/10 * * * *"
    ]
  },
  "vars": {
    "BACKEND_ORIGIN": "https://portalproject-248060026367.europe-west1.run.app"
  }
}
